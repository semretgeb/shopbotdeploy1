# --- Telegram ---
BOT_TOKEN=123456:ABC-your-bot-token
BOT_USERNAME=YourShopBot
# Random string (openssl rand -hex 24). Telegram sends it back on every webhook call.
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Public HTTPS base URL of this app (no trailing slash)
PUBLIC_URL=https://your-subdomain.ethiodeploy.com
ADMIN_TELEGRAM_ID=123456789

# --- Database ---
# Local default is SQLite. EthioDeploy managed Postgres injects DATABASE_URL.
DATABASE_URL=sqlite:///./shopbot.db

# --- Business ---
SUBSCRIPTION_PRICE_ETB=500
PAYMENT_ACCOUNT=Telebirr 09XXXXXXXX (Your Name)
TRIAL_DAYS=14

# --- AI (Groq) ---
GROQ_API_KEY=gsk_your_key
GROQ_MODEL=llama-3.3-70b-versatile
AI_PER_CUSTOMER_HOURLY=10
AI_PER_SHOP_DAILY=300
AI_GLOBAL_DAILY=3000

# --- Misc ---
IMAGE_CACHE_DIR=/tmp/shopbot-img
IMAGE_CACHE_MAX_MB=200
LOG_LEVEL=INFO
ENV=development
