# ── ShopBot Environment Variables ──────────────────────────
# Fill in your keys below then save this file as .env

# Get this from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Get this FREE from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Your personal Telegram user ID (get it from @userinfobot on Telegram)
OWNER_TELEGRAM_ID=your_telegram_user_id_here
